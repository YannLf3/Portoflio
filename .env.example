# ---------------------------------------------------------------------------
# Modèle de configuration — copier en « .env » à la racine du projet.
# Le vrai .env n'est JAMAIS versionné (.gitignore) ni écrasé lors d'un déploiement.
# Les 4 clés sont obligatoires (DB_PASS peut être vide en local) :
# app/config/database.php n'a plus aucune valeur de repli dans le code.
# ---------------------------------------------------------------------------

# Développement Docker (docker-compose.yml)
DB_HOST=db
DB_NAME=portfolio_db
DB_USER=root
DB_PASS=root

# Production Hostinger (valeurs dans hPanel → Bases de données MySQL) :
# DB_HOST=localhost
# DB_NAME=u000000000_nom_de_la_base
# DB_USER=u000000000_utilisateur
# DB_PASS=mot_de_passe_de_la_base
