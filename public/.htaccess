<IfModule mod_headers.c>
    # En-tête de sécurité HSTS.
    # Placé dans mod_headers (et non mod_rewrite) : sans ce module, la directive "Header" provoque une erreur 500.
    # Les navigateurs ignorent HSTS reçu en HTTP, il est donc sans effet en local sur http://localhost.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0. Redirection 301 : forcer le HTTPS (sauf en local). X-Forwarded-Proto évite une boucle si un proxy/CDN termine le SSL.
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 1. Redirection 301 : Forcer la version sans "www" pour le SEO
    # %1 = domaine capturé par CETTE condition : aucune autre RewriteCond ne doit s'intercaler avant la règle.
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # 2. Routage vers le Front Controller (Architecture MVC)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
